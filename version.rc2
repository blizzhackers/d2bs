// D2BS.dll version information, included by version.rc. It lives here because Visual Studio's resource editor
// rewrites version.rc and would replace these macros with literal numbers.
// build\Build-D2BS.ps1 passes D2BS_BUILD_INFO and generates d2bs_build.h from VERSION and the commit; builds without
// it are 0.0.0.0 / "local build".
#ifdef D2BS_BUILD_INFO
#include "d2bs_build.h"
#else
#define D2BS_FILEVERSION 0,0,0,0
#define D2BS_FILEVERSION_STR "0.0.0.0"
#define D2BS_PRODUCTVERSION_STR "local build"
#endif

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

VS_VERSION_INFO VERSIONINFO
 FILEVERSION D2BS_FILEVERSION
 PRODUCTVERSION D2BS_FILEVERSION
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "D2BS Team"
            VALUE "FileDescription", "Diablo II Botting System"
            VALUE "FileVersion", D2BS_FILEVERSION_STR
            VALUE "InternalName", "D2BS"
            VALUE "LegalCopyright", "Copyright (C) 2010"
            VALUE "OriginalFilename", "D2BS.dll"
            VALUE "ProductName", "Diablo II Botting System"
            VALUE "ProductVersion", D2BS_PRODUCTVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
